QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=private_pdf_chunks_v3
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=86400
CACHE_SIMILARITY_THRESHOLD=0.965
CACHE_VERSION=corpus-v1
PDF_DIR=/app/data/pdfs
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
RERANK_MODEL=ms-marco-TinyBERT-L-2-v2
OCR_LANG=eng
LLM_BASE_URL=https://YOUR-OPENAI-COMPATIBLE-ENDPOINT/v1
LLM_API_KEY=replace-me
LLM_MODEL=your-open-weight-instruct-model
LLM_TIMEOUT_SECONDS=18
LLM_MAX_TOKENS=350
API_KEY=replace-with-openssl-rand-hex-32
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
MAX_CONCURRENT_GENERATIONS=12
DATABASE_URL=postgresql://rag:change-this-password@postgres:5432/rag
DB_POOL_MAX=20
SESSION_TTL_DAYS=30
HISTORY_RECENT_MESSAGES=12
HISTORY_MAX_CHARS=12000
SUMMARY_TRIGGER_MESSAGES=20
USER_RPM=30
SESSION_RPM=12
GLOBAL_RPM=300
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
TOP_DENSE=50
TOP_BM25=50
RERANK_TOP_N=25
FINAL_CONTEXT_CHUNKS=7
MAX_CONTEXT_TOKENS=4500
CHUNK_TOKENS=650
CHUNK_OVERLAP_TOKENS=100
CORS_ORIGINS=http://localhost:3000

# Fast query-domain routing confidence threshold
QUERY_DOMAIN_MIN_CONFIDENCE=0.62
